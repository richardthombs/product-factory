#!/usr/bin/env sh
set -eu

REMOTE_NAME="${1:-origin}"
TARGET_BRANCH="${GIT_MAIN_GATE_BRANCH:-main}"
TARGET_REF="refs/heads/${TARGET_BRANCH}"

should_gate=false

while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  if [ "${remote_ref}" = "${TARGET_REF}" ]; then
    should_gate=true
    break
  fi
done

if [ "${should_gate}" != "true" ]; then
  exit 0
fi

printf '%s\n' "pre-push: gating push to ${REMOTE_NAME}/${TARGET_BRANCH}" >&2

git fetch "${REMOTE_NAME}" "${TARGET_BRANCH}" --quiet
npm test
npm run rebuild
npm run reconcile-events -- --base "${REMOTE_NAME}/${TARGET_BRANCH}"
